<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.lighthousekeeper.review-handoff-monitor</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>__KEEPER_REVIEW_MONITOR_SCRIPT__</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>14400</integer>
  <key>StandardOutPath</key>
  <string>/Users/frank/Library/Logs/LighthouseKeeper/keeper-review-handoff-monitor.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/frank/Library/Logs/LighthouseKeeper/keeper-review-handoff-monitor-error.log</string>
</dict>
</plist>
