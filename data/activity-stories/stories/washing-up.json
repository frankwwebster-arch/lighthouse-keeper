{
  "schema": "lighthouse-keeper/activity-story@1",
  "id": "washing-up",
  "label": "Washing up",
  "appliesTo": { "assetId": "kitchen.sink", "label": "Kitchen sink" },
  "bodyCompatibility": "rear-work-with-context",
  "afterStory": "loop",
  "pace": 1,
  "cast": {
    "plate": { "picture": "washing-plate", "role": "hero" },
    "liquid": { "picture": "washing-liquid", "role": "support" },
    "sponge": { "picture": "washing-sponge", "role": "support" },
    "rinse": { "picture": "washing-droplets", "role": "support" },
    "cutlery": { "picture": "washing-cutlery", "role": "result" }
  },
  "steps": [
    { "do": "arrive", "who": "plate" },
    { "do": "pour", "who": "liquid", "onto": "plate", "mark": "symbol-soap-bubbles" },
    { "do": "scrub", "who": "sponge", "onto": "plate" },
    { "do": "drop-in", "who": "rinse", "onto": "plate", "mark": "symbol-water-droplets" },
    { "do": "reveal", "who": "cutlery", "onto": "plate" },
    { "do": "settle" }
  ],
  "ambient": [{ "picture": "symbol-foul-odour", "on": "plate", "fromStep": 1, "toStep": 1 }],
  "sfx": [
    { "step": 2, "at": "start", "cue": "tap-water", "owner": "kitchen.sink", "kind": "asset-state" },
    { "step": 3, "at": "contact", "cue": "sponge-scrub", "owner": "washing-up", "kind": "activity-beat" },
    { "step": 5, "at": "contact", "cue": "clean-clink", "owner": "washing-up", "kind": "completion" }
  ],
  "notes": "Draft by Claude, 20 Oct 2026. A dirty plate (foul odour) gets soap, a real scrub with soap-bubble marks instead of crash stars, a rinse, then clean cutlery."
}
