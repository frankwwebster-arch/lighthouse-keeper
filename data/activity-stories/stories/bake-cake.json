{
  "schema": "lighthouse-keeper/activity-story@1",
  "bodyCompatibility": "rear-work-with-context",
  "afterStory": "loop",
  "pace": 1,
  "flow": "left-to-right",
  "id": "bake-cake",
  "label": "Bake a cake",
  "appliesTo": {
    "assetId": "kitchen.oven",
    "label": "Oven"
  },
  "cast": {
    "bowl": {
      "picture": "mixing-bowl",
      "role": "hero"
    },
    "flour": {
      "picture": "baking-flour",
      "role": "support"
    },
    "egg": {
      "picture": "mixing-egg",
      "role": "support"
    },
    "butter": {
      "picture": "ingredient-butter-block",
      "role": "support"
    },
    "whisk": {
      "picture": "mixing-whisk",
      "role": "support"
    },
    "cake": {
      "picture": "baking-cake",
      "role": "result",
      "appear": "symbol-pleasant-aroma"
    }
  },
  "steps": [
    {
      "do": "arrive",
      "who": "bowl"
    },
    {
      "do": "pour",
      "who": "flour",
      "onto": "bowl",
      "mark": "symbol-motion-ticks"
    },
    {
      "do": "drop-in",
      "who": "egg",
      "onto": "bowl"
    },
    {
      "do": "drop-in",
      "who": "butter",
      "onto": "bowl",
      "speed": "quick"
    },
    {
      "do": "stir",
      "who": "whisk",
      "onto": "bowl",
      "speed": "slow"
    },
    {
      "do": "pause",
      "speed": "slow"
    },
    {
      "do": "reveal",
      "who": "cake",
      "onto": "bowl",
      "replace": true
    },
    {
      "do": "serve",
      "who": "cake"
    },
    {
      "do": "settle"
    }
  ],
  "ambient": [
    {
      "picture": "symbol-heat-curls",
      "on": "bowl",
      "fromStep": 6,
      "toStep": 6
    }
  ],
  "sfx": [
    {
      "step": 5,
      "at": "contact",
      "cue": "whisk",
      "owner": "bake-cake",
      "kind": "activity-beat"
    }
  ],
  "notes": "Draft by Claude, 21 Oct 2026. Flour pours into the bowl, the egg and butter drop in, the whisk goes round, heat while it bakes, then the cake appears (a good smell) and is served.",
  "props": []
}
