  "visual": {
    "stylePhrase": "Polished hand-painted 2D game iconography for a cosy maritime Lighthouse Keeper game; smooth dark-navy outer contours, warm cream highlights, aged brass and copper, sea-glass teal, storm blue and restrained coral; tactile materials, compact silhouettes and clear reading at game scale.",
    "paletteAnchors": {
      "deepInk": "#14243a",
      "charcoal": "#23262b",
      "warmCream": "#f3e7cc",
      "brassLight": "#e6b955",
      "seaTeal": "#267da0",
      "seaGlass": "#68a7c5",
      "restrainedCoral": "#c8463c"
    },
    "requiredTraits": [
      "strong-readable-silhouette",
      "substantial-dark-navy-outer-contour",
      "purposeful-material-values",
      "restrained-form-describing-highlights",
      "subtle-tactile-painterly-texture",
      "compact-centred-mass",
      "readable-at-thumbnail-size",
      "genuine-transparent-background"
    ],
    "forbiddenTraits": [
      "flat-generic-symbol",
      "stock-icon-or-emoji-language",
      "photorealism",
      "glossy-mobile-app-icon",
      "hard-extruded-3d",
      "neon-rendering",
      "background-panel-tile-floor-or-room",
      "vignette-aura-haze-or-margin-glow",
      "margin-cast-shadow",
      "text-letter-number-logo-brand-or-watermark",
      "keeper-or-unrequested-person",
      "unrelated-second-object",
      "stray-or-duplicate-fragment",
      "context-baked-into-keeper-or-household-asset"
    ],
    "tokenScope": "one-semantic-object-or-one-story-cue",
    "combinedTokenRule": "Allowed only when parts form one ordinary inseparable semantic unit.",
    "identitySafety": "Use fictional archetypes and motif-only homages; never exact real-person likenesses or copied album artwork, titles, logos, typography or photographs.",
    "familySafety": "Bathroom, sleeping and washing cues must be discreet, family-safe and non-anatomical."
  },
  "generation": {
    "preferredMode": "one-isolated-token-per-generation",
    "allowedBatchMode": "1536x1024-rgba-3x2-six-token-sheet",
    "promptLogRequired": true,
    "promptLogFields": [
      "generation-date",
      "generator",
      "exact-prompt",
      "reference-role",
      "accepted-source-filename",
      "accepted-source-sha256",
      "rejected-attempt-count-and-reason",
      "edit-provenance",
      "normalisation-rule"
    ],
    "singleTokenPromptRequiredPhrases": [
      "exactly one",
      "genuinely transparent background",
      "polished hand-painted 2D game illustration",
      "dark-navy outer line",
      "readable at thumbnail size",
      "generous transparent margin",
      "no text",
      "no logo",
      "no watermark",
      "no glow"
    ],
    "sheet": {
      "pixels": [1536, 1024],
      "grid": [3, 2],
      "cellPixels": [512, 512],
      "centralSubjectPixels": [352, 352],
      "promptedCellMarginPixels": 80,
      "transparentBoundaryLines": {
        "x": [512, 1024],
        "y": [512]
      },
      "ownerOrder": "row-major-reading-order"
    },
    "badSourcePolicy": "Rerender the affected token or sheet; never hide overlap, haze or an extra owner with a tighter crop."
  },
  "raster": {
    "componentCellPixels": [256, 256],
    "visibleAlphaThreshold": 8,
    "minimumTransparentGutterPixels": 16,
    "preferredTransparentGutterPixels": 20,
    "sourceOuterEdgeVisiblePixels": 0,
    "ownersPerComponent": 1,
    "ambiguousPixels": 0,
    "unownedVisiblePixels": 0,
    "outputEdgeAlphaPixels": 0,
    "scaling": "uniform-lossless-normalisation-into-fresh-transparent-cell",
    "placement": "deterministic-integer-centering",
    "requiredRegisterFields": [
      "componentId",
      "family",
      "owner",
      "sourceFile",
      "sourceBounds",
      "normalisedSize",
      "offset",
      "cellPixels",
      "minimumGutterPixels",
      "sourceSha256",
      "outputSha256",
      "ambiguousPixels",
      "unownedVisiblePixels",
      "edgeAlphaPixels"
    ]
  },
  "component": {
    "idPattern": "^[a-z0-9]+(?:-[a-z0-9]+)+$",
    "idForm": "<family>-<specific-object-or-cue>",
    "requiredCatalogueFields": ["src", "sha256", "family", "cellPixels", "sourceSet"],
    "renamePolicy": "Never rename an existing id; add a new immutable component when meaning changes."
  },
  "recipe": {
    "minimumElements": 4,
    "maximumElements": 5,
    "heroElementIndex": 0,
    "requiredFields": [
      "label",
      "targetAssetLabel",
      "targetAssetId",
      "bodyCompatibility",
      "elements",
      "sfx"
    ],
    "bodyCompatibilityValues": ["rear-work-with-context", "dedicated-pose-required"],
    "dedicatedPoseBodyVisible": false,
    "storyPatterns": [
      "source-process-result",
      "ingredients-assembly-result",
      "place-or-tool-action-outcome",
      "instrument-performer-notation"
    ],
    "timeOfDayRule": "Variants belong in recipe metadata and selection logic, never component pixels.",
    "sfxOwnership": "Contextual recipe owns SFX; Keeper body and component cells are silent."
  },
  "presentation": {
    "requiredTreatments": ["orbit", "bustle"],
    "treatmentMeanings": {
      "orbit": "open-radial-no-enclosing-bubble",
      "bustle": "compact-activity-bubble-or-puff"
    },
    "calloutFrames": 42,
    "calloutFps": 8,
    "quietTailFrames": 5,
    "bodyFrames": 24,
    "bodyFps": 4,
    "bodyNeutralFrames": [1, 23, 24],
    "placement": "raised-above-cap-with-verified-clear-gap-inside-room-safe-zone",
    "foregroundReviewCounterAllowed": false,
    "preloadAndDecodeBeforePlayback": true,
    "reducedMotion": "one-primary-and-one-secondary-object-with-minimal-marks"
  },
  "notation": {
    "triggerFamily": "music",
    "independentlyControllable": true,
    "seedAlgorithm": "fnv1a32-v1",
    "sequenceLengthFrames": 6,
    "visibleNotes": 3,
    "bakedIntoComponents": false
  },
  "separation": {
    "independentLayers": [
      "keeper-body",
      "treatment-or-cloud-marks",
      "primary-or-resolved-object",
      "supporting-or-story-objects",
      "music-notation",
      "contextual-household-asset",
      "asset-effects",
      "sfx-declarations"
    ],
    "immutableAuthorities": [
      "approved-walk",
      "approved-stop",
      "approved-turn",
      "approved-rear-neutral",
      "complete-approved-route"
    ]
  },
  "versioning": {
    "immutableVersionRequired": true,
    "overwritePreviousVersion": false,
    "contentAddressedReviewMedia": true,
    "discardBoundary": [
      "new-draft-directory",
      "new-public-review-page",
      "new-archive-set",
      "new-content-addressed-objects"
    ],
    "runtimePromotionRequiresExplicitApproval": true,
    "deploymentRequiresExplicitApproval": true,
    "kitchenChangesAllowed": false
  },
  "knownRejectedPatterns": [
    "v1-flat-generic-symbols",
    "alpha-crossing-source-ownership-line",
    "opaque-or-glowing-halo",
    "tight-crop-used-to-hide-overlap",
    "foreground-review-counter",
    "callout-too-low-against-cap",
    "contextual-prop-baked-into-keeper",
    "vocabulary-used-as-body-compatibility-proof",
    "non-deterministic-unreplayable-placement"
  ]
}
